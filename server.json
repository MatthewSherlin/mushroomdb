{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.MatthewSherlin/mushroomdb",
  "description": "Embedded graph database for agents: declare association rules once, edges maintain themselves.",
  "repository": {
    "url": "https://github.com/MatthewSherlin/mushroomdb",
    "source": "github",
    "id": "1334631677"
  },
  "version": "0.4.5",
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "mushroomdb-cli",
      "version": "0.4.5",
      "runtimeHint": "cargo",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "valueHint": "subcommand"
        },
        {
          "type": "positional",
          "description": "Path to the database directory",
          "isRequired": true,
          "format": "filepath",
          "placeholder": "/path/to/your/db",
          "valueHint": "db_dir"
        }
      ]
    }
  ]
}
