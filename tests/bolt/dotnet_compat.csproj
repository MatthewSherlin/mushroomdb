<Project Sdk="Microsoft.NET.Sdk">
  <!-- Scratch-only manifest for the .NET driver check (tests/bolt/extra_driver.sh
       fills the placeholders). Not part of the product's build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="@VENDOR_CAP@.Driver" Version="@DOTNET_VERSION@" />
  </ItemGroup>
</Project>
