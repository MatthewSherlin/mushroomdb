{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y mushroomdb@{{VERSION}} recall --auto",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y mushroomdb@{{VERSION}} touch --auto",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
