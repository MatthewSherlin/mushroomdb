{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y mushroomdb@0.5.2 recall --auto",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y mushroomdb@0.5.2 touch --auto",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
