{
  "name": "mushroomdb",
  "version": "0.9.3",
  "description": "Embedded graph database for agents: declare a relationship as a rule, and the edges maintain themselves. This package launches the native binary.",
  "mcpName": "io.github.MatthewSherlin/mushroomdb",
  "homepage": "https://matthewsherlin.github.io/mushroomdb/",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatthewSherlin/mushroomdb.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "mushroomdb": "bin/mushroomdb.js"
  },
  "scripts": {
    "postinstall": "node install.js"
  },
  "files": [
    "install.js",
    "bin/mushroomdb.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
