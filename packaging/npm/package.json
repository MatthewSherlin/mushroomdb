{
  "name": "mushroomdb",
  "version": "0.10.0",
  "description": "Embedded graph database with Cypher queries, rule-derived edges, time travel, and agent-memory tools. This package launches the native binary.",
  "mcpName": "io.github.MatthewSherlin/mushroomdb",
  "homepage": "https://matthewsherlin.github.io/mushroomdb/",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatthewSherlin/mushroomdb.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "mushroomdb": "bin/mushroomdb.js"
  },
  "scripts": {
    "postinstall": "node install.js"
  },
  "keywords": [
    "graph",
    "embedded",
    "database",
    "cypher",
    "graph-database",
    "mcp",
    "agent-memory"
  ],
  "files": [
    "install.js",
    "bin/mushroomdb.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
