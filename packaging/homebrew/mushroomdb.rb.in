# Generated formula. The in-tree copy is a template; the GitHub Release
# asset mushroomdb.rb is the tap-ready file with real sha256 values.
class Mushroomdb < Formula
  desc "Embedded property-graph database with incremental linking rules"
  homepage "https://github.com/MatthewSherlin/mushroomdb"
  version "__VERSION__"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/MatthewSherlin/mushroomdb/releases/download/v__VERSION__/mushroomdb-v__VERSION__-aarch64-apple-darwin.tar.gz"
      sha256 "__SHA_AARCH64_APPLE_DARWIN__"
    end
    on_intel do
      url "https://github.com/MatthewSherlin/mushroomdb/releases/download/v__VERSION__/mushroomdb-v__VERSION__-x86_64-apple-darwin.tar.gz"
      sha256 "__SHA_X86_64_APPLE_DARWIN__"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/MatthewSherlin/mushroomdb/releases/download/v__VERSION__/mushroomdb-v__VERSION__-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA_AARCH64_UNKNOWN_LINUX_GNU__"
    end
    on_intel do
      url "https://github.com/MatthewSherlin/mushroomdb/releases/download/v__VERSION__/mushroomdb-v__VERSION__-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA_X86_64_UNKNOWN_LINUX_GNU__"
    end
  end

  def install
    bin.install "mushroomdb"
  end

  test do
    output = shell_output("#{bin}/mushroomdb --help")
    assert_match "mushroomdb", output
  end
end
